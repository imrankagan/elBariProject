<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Koruma adımları sadece Release build'de çalışır -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
	<EnableProtection>true</EnableProtection>
	<ObfuscarToolPath Condition="'$(ObfuscarToolPath)' == ''">$(MSBuildThisFileDirectory)tools\Obfuscar.Console.exe</ObfuscarToolPath>
	<ProtectedOutputPath>$(OutputPath)protected\</ProtectedOutputPath>
  </PropertyGroup>

  <!-- Koruma bilgilendirmesi -->
  <Target Name="ShowProtectionWarning" BeforeTargets="CoreCompile" Condition="'$(EnableProtection)' == 'true'">
	<Message Text="===========================================" Importance="high" />
	<Message Text="ElBâri Code Protection Pipeline Enabled" Importance="high" />
	<Message Text="- Native AOT: ✓ Active" Importance="high" />
	<Message Text="- Obfuscation: Ready (requires Obfuscar tool)" Importance="high" />
	<Message Text="===========================================" Importance="high" />
  </Target>

  <!-- NOT: DisablePrivateReflection ve SuppressIldasm attribute'ları kaldırıldı.
       .NET 6.0+ üzerinde hiçbir etkileri yok (SYSLIB0015 / SYSLIB0025) ve Native AOT
       zaten IL göndermediği için ILDASM/reflection tabanlı korumaları gereksiz kılar. -->

  <!-- Post-build obfuscation adımı (opsiyonel - araç yüklüyse) -->
  <Target Name="RunObfuscation" AfterTargets="Build" Condition="'$(EnableProtection)' == 'true' AND Exists('$(ObfuscarToolPath)')">
	<Message Text="Running Obfuscar code protection..." Importance="high" />

	<!-- Korumalı çıktı dizinini oluştur -->
	<MakeDir Directories="$(ProtectedOutputPath)" />

	<!-- Obfuscar çalıştır -->
	<Exec Command="&quot;$(ObfuscarToolPath)&quot; obfuscar.xml"
		  WorkingDirectory="$(ProjectDir)"
		  IgnoreExitCode="false" />

	<Message Text="Code protection completed: $(ProtectedOutputPath)" Importance="high" />
  </Target>

  <!-- Obfuscar yüklü değilse bilgilendirme (opsiyonel adım olduğu için uyarı değil, info) -->
  <Target Name="InformMissingObfuscator" AfterTargets="Build" Condition="'$(EnableProtection)' == 'true' AND !Exists('$(ObfuscarToolPath)')">
	<Message Text="Obfuscar (opsiyonel) bulunamadı: $(ObfuscarToolPath) — obfuscation adımı atlandı." Importance="high" />
	<Message Text="Etkinleştirmek için: dotnet tool install --global Obfuscar.GlobalTool" Importance="high" />
	<Message Text="  veya indir: https://github.com/obfuscar/obfuscar" Importance="high" />
	<Message Text="Native AOT koruması zaten aktif." Importance="high" />
  </Target>

  <!-- Strong name signing (opsiyonel - key dosyası varsa) -->
  <PropertyGroup Condition="'$(EnableProtection)' == 'true' AND Exists('$(ProjectDir)ElBâri.snk')">
	<SignAssembly>true</SignAssembly>
	<AssemblyOriginatorKeyFile>ElBâri.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <!-- IL strip (AOT için) - IL code'u tamamen kaldır -->
  <PropertyGroup Condition="'$(EnableProtection)' == 'true' AND '$(PublishAot)' == 'true'">
	<IlcGenerateMstatFile>false</IlcGenerateMstatFile>
	<IlcGenerateDgmlFile>false</IlcGenerateDgmlFile>
	<IlcGenerateMapFile>false</IlcGenerateMapFile>
	<DebugType>none</DebugType>
	<DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

</Project>
